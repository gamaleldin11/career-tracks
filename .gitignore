# ---- build output (Vercel rebuilds it on every push to main; the local diagram
# checks live in site/qa/, not here, because dist/ is never committed)
dist/

# ---- dependencies
node_modules/
.npm/

# ---- logs and caches
*.log
npm-debug.log*
.cache/
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ---- secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# ---- reference material that must not be published
# (copyrighted books, course archives, private backups)
*.pdf
*.zip
*.7z
*.rar
_backup*/
private/

# ---- editors and tools
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.obsidian/
# Claude Code: keep the shared preview config, ignore per-machine settings
.claude/*
!.claude/launch.json

# ---- operating systems
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Vercel CLI link data
.vercel/
